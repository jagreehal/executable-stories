{
  "name": "executable-stories-demo",
  "version": "0.1.21",
  "description": "Publish Astro product demo sites from executable stories runs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "bin"
  ],
  "bin": {
    "executable-stories-demo": "./bin/executable-stories-demo.js"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "executable-stories-formatters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/executable-stories.git",
    "directory": "packages/executable-stories-demo"
  },
  "keywords": [
    "executable-stories",
    "playwright",
    "astro",
    "demo",
    "publishing"
  ]
}
