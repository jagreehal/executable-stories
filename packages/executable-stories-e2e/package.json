{
  "name": "executable-stories-e2e",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "executable-stories reporter for the e2e agentic test runner: turns its report-1 document into story docs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "e2e": ">=0.15.0"
  },
  "dependencies": {
    "executable-stories-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "e2e": "0.15.1",
    "eslint-config-executable-stories": "workspace:*",
    "executable-stories-formatters": "workspace:*",
    "executable-stories-vitest": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/executable-stories.git",
    "directory": "packages/executable-stories-e2e"
  },
  "keywords": [
    "e2e",
    "agentic-testing",
    "bdd",
    "documentation",
    "executable-stories"
  ]
}
