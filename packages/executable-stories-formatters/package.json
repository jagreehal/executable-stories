{
  "name": "executable-stories-formatters",
  "version": "1.0.0",
  "description": "Cucumber-compatible report formats (HTML, Markdown, JUnit XML, Cucumber JSON) for executable-stories test results.",
  "author": "Jag Reehal <jag@jagreehal.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/executable-stories.git",
    "directory": "packages/executable-stories-formatters"
  },
  "homepage": "https://github.com/jagreehal/executable-stories#readme",
  "bugs": {
    "url": "https://github.com/jagreehal/executable-stories/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js",
      "require": "./dist/adapters.cjs"
    }
  },
  "bin": {
    "executable-stories": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "schemas",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "executable-stories",
    "bdd",
    "testing",
    "documentation",
    "cucumber",
    "html",
    "markdown",
    "junit",
    "report",
    "formatter"
  ],
  "scripts": {
    "embed-assets": "node scripts/embed-react-assets.mjs",
    "build": "node scripts/embed-react-assets.mjs && tsup",
    "test": "node scripts/embed-react-assets.mjs && vitest run",
    "test:watch": "node scripts/embed-react-assets.mjs && vitest",
    "type-check": "node scripts/embed-react-assets.mjs && tsc --noEmit",
    "compile": "node scripts/embed-react-assets.mjs && bun build src/cli.ts --compile --outfile executable-stories",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@cucumber/html-formatter": "^23.1.0",
    "@cucumber/messages": "^32.3.1",
    "ajv": "^8.20.0",
    "github-slugger": "^2.0.0",
    "yaml": "^2.9.0",
    "executable-stories-core": "workspace:*",
    "executable-stories-react": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@storybook/html": "^10.4.6",
    "@storybook/html-vite": "^10.4.6",
    "@types/node": "^25.9.2",
    "storybook": "^10.4.6",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8",
    "vitest-mock-extended": "^4.0.0"
  }
}
