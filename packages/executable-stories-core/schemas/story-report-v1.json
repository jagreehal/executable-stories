{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://executable-stories.dev/schemas/story-report-v1.schema.json",
  "title": "StoryReport",
  "description": "Pre-grouped, denormalized report shape consumed by UI renderers (React, Svelte, Vue, etc.). Stable public contract \u2014 additive-only within a major. Distinct from internal TestRunResult.",
  "type": "object",
  "$ref": "#/$defs/StoryReport",
  "$defs": {
    "StoryReport": {
      "type": "object",
      "description": "Top-level report containing all features, runtime metadata, and a pre-computed summary.",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$",
          "description": "Schema version as 'major.minor'. Major bumps are breaking; minors are additive-only. UI packages must accept any 1.x."
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "description": "Unique deterministic identifier for this run."
        },
        "startedAtMs": {
          "type": "number",
          "minimum": 0,
          "description": "Run start time as Unix epoch milliseconds."
        },
        "finishedAtMs": {
          "type": "number",
          "minimum": 0,
          "description": "Run finish time as Unix epoch milliseconds."
        },
        "durationMs": {
          "type": "number",
          "minimum": 0,
          "description": "Total run duration in milliseconds."
        },
        "projectRoot": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path to the project root (for context only; relative paths in features.sourceFile are preferred)."
        },
        "packageVersion": {
          "type": "string",
          "description": "Version of the package under test, if known."
        },
        "gitSha": {
          "type": "string",
          "description": "Git commit SHA at the time of the run."
        },
        "ci": {
          "$ref": "#/$defs/CIInfo"
        },
        "coverage": {
          "$ref": "#/$defs/CoverageSummary"
        },
        "summary": {
          "$ref": "#/$defs/Summary",
          "description": "Pre-computed counts across all features and scenarios."
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "description": "Features grouped by sourceFile, sorted by title."
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "startedAtMs",
        "finishedAtMs",
        "durationMs",
        "projectRoot",
        "summary",
        "features"
      ],
      "additionalProperties": false
    },
    "Summary": {
      "type": "object",
      "description": "Counts by status. Sums equal 'total'.",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "skipped",
        "pending",
        "durationMs"
      ],
      "additionalProperties": false
    },
    "Feature": {
      "type": "object",
      "description": "A group of scenarios from the same source file.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable slug derived from the relative source path. Suitable for use as a deep-link anchor."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Display title. Derived from describe block when present, otherwise the file basename."
        },
        "sourceFile": {
          "type": "string",
          "minLength": 1,
          "description": "Source path, relative to projectRoot when possible."
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scenario"
          },
          "description": "Scenarios in this feature, in declaration order."
        }
      },
      "required": [
        "id",
        "title",
        "sourceFile",
        "summary",
        "scenarios"
      ],
      "additionalProperties": false
    },
    "Scenario": {
      "type": "object",
      "description": "A single scenario with its steps, story-level doc entries, and attachments.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier: '<feature.id>--<slug-of-title>'. Suitable for use as a deep-link anchor."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/TestStatus"
        },
        "planned": {
          "type": "boolean",
          "description": "True for scenarios authored with the framework's todo modifier (e.g. it.todo): specified behavior with no implementation yet. Canonical status stays 'pending'; this flags why."
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Normalized tags, deduplicated, lowercased."
        },
        "tickets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ticket"
          }
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Product-code paths/globs this scenario exercises."
        },
        "sourceLine": {
          "type": "integer",
          "minimum": 1
        },
        "errorMessage": {
          "type": "string"
        },
        "errorStack": {
          "type": "string"
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "docEntries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          },
          "description": "Story-level doc entries (rendered before steps)."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attachment"
          }
        },
        "otelSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OtelSpan"
          }
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "durationMs",
        "tags",
        "retry",
        "retries",
        "docEntries",
        "steps",
        "attachments"
      ],
      "additionalProperties": false
    },
    "Step": {
      "type": "object",
      "description": "A single BDD step.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "keyword": {
          "$ref": "#/$defs/StepKeyword"
        },
        "text": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TestStatus"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "errorMessage": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/StepMode"
        },
        "docEntries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          },
          "description": "Doc entries attached to this step."
        }
      },
      "required": [
        "id",
        "index",
        "keyword",
        "text",
        "status",
        "durationMs",
        "docEntries"
      ],
      "additionalProperties": false
    },
    "StepKeyword": {
      "type": "string",
      "enum": [
        "Given",
        "When",
        "Then",
        "And",
        "But"
      ]
    },
    "StepMode": {
      "type": "string",
      "enum": [
        "normal",
        "skip",
        "only",
        "todo",
        "fails",
        "concurrent"
      ]
    },
    "TestStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped",
        "pending"
      ]
    },
    "Ticket": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "Attachment": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "contentEncoding": {
          "type": "string",
          "enum": [
            "BASE64",
            "IDENTITY"
          ]
        }
      },
      "required": [
        "name",
        "mediaType",
        "body",
        "contentEncoding"
      ],
      "additionalProperties": false
    },
    "CIInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "buildNumber": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commitSha": {
          "type": "string"
        },
        "prNumber": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "CoverageSummary": {
      "type": "object",
      "properties": {
        "linesPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "branchesPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "functionsPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "statementsPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "DocPhase": {
      "type": "string",
      "enum": [
        "static",
        "runtime"
      ]
    },
    "DocEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/DocNote"
        },
        {
          "$ref": "#/$defs/DocTag"
        },
        {
          "$ref": "#/$defs/DocKv"
        },
        {
          "$ref": "#/$defs/DocCode"
        },
        {
          "$ref": "#/$defs/DocTable"
        },
        {
          "$ref": "#/$defs/DocLink"
        },
        {
          "$ref": "#/$defs/DocSection"
        },
        {
          "$ref": "#/$defs/DocMermaid"
        },
        {
          "$ref": "#/$defs/DocScreenshot"
        },
        {
          "$ref": "#/$defs/DocVideo"
        },
        {
          "$ref": "#/$defs/DocHtml"
        },
        {
          "$ref": "#/$defs/DocState"
        },
        {
          "$ref": "#/$defs/DocCustom"
        }
      ]
    },
    "DocNote": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "note"
        },
        "text": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "text",
        "phase"
      ],
      "additionalProperties": false
    },
    "DocTag": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "tag"
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "names",
        "phase"
      ],
      "additionalProperties": false
    },
    "DocKv": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "kv"
        },
        "label": {
          "type": "string"
        },
        "value": {},
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "label",
        "value",
        "phase"
      ],
      "additionalProperties": false
    },
    "DocCode": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "code"
        },
        "label": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "label",
        "content",
        "phase"
      ],
      "additionalProperties": false
    },
    "DocTable": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "table"
        },
        "label": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "label",
        "columns",
        "rows",
        "phase"
      ],
      "additionalProperties": false
    },
    "DocLink": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "link"
        },
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "label",
        "url",
        "phase"
      ],
      "additionalProperties": false
    },
    "DocSection": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "section"
        },
        "title": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "title",
        "markdown",
        "phase"
      ],
      "additionalProperties": false
    },
    "DocMermaid": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "mermaid"
        },
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "code",
        "phase"
      ],
      "additionalProperties": false
    },
    "DocScreenshot": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "screenshot"
        },
        "path": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "path",
        "phase"
      ],
      "additionalProperties": false
    },
    "DocVideo": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "video"
        },
        "path": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "poster": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "path",
        "phase"
      ],
      "additionalProperties": false
    },
    "DocHtml": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "html"
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "height": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "phase"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "content"
          ]
        }
      ]
    },
    "DocState": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "state"
        },
        "label": {
          "type": "string"
        },
        "value": {},
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "value",
        "phase"
      ],
      "additionalProperties": false
    },
    "DocCustom": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "custom"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "data": {},
        "phase": {
          "$ref": "#/$defs/DocPhase"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocEntry"
          }
        }
      },
      "required": [
        "kind",
        "type",
        "data",
        "phase"
      ],
      "additionalProperties": false
    },
    "OtelSpan": {
      "type": "object",
      "required": [
        "spanId",
        "name",
        "status"
      ],
      "properties": {
        "spanId": {
          "type": "string"
        },
        "parentSpanId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "startTimeMs": {
          "type": "number"
        },
        "durationMs": {
          "type": "number"
        },
        "startTimeUnixNano": {
          "type": "number"
        },
        "endTimeUnixNano": {
          "type": "number"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "unset"
          ]
        },
        "statusMessage": {
          "type": "string"
        },
        "attributes": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
