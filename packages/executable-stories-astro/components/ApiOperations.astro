---
/**
 * <ApiOperations tag="Transfers" hasRun endpoints={[...]} summary={{...}} />
 *
 * Renders the API coverage table for one OpenAPI tag. Generated by
 * `executable-stories import-openapi`, which writes an MDX page that imports
 * this component (`executable-stories-astro/components/ApiOperations.astro`) and
 * passes the endpoints + their test coverage.
 *
 * Each endpoint shows an HTTP-method pill, its path, a coverage badge, and the
 * stories that exercise it — linked straight into the Scenario Explorer, so the
 * API docs can never drift from the tests that prove them.
 *
 * Standalone: the styles read the `--es-*` tokens this package ships (es.css)
 * and Starlight's `--sl-*` tokens when present, with light-theme fallbacks, so
 * the table looks at home in any Astro site.
 */

/** Per-endpoint coverage verdict (local to API docs — not a scenario status). */
type CoverageStatus = "covered" | "failing" | "uncovered";

/** A story that exercises an endpoint. `status` is the scenario's report status. */
export interface ApiStoryRef {
  id: string;
  title: string;
  status: string;
}

export interface ApiEndpoint {
  method: string;
  path: string;
  summary: string;
  status: CoverageStatus;
  stories: ApiStoryRef[];
}

interface Props {
  tag: string;
  hasRun: boolean;
  endpoints: ApiEndpoint[];
  summary: { total: number; covered: number; failing: number; uncovered: number };
}

const { hasRun, endpoints, summary } = Astro.props;

const coverageLabel: Record<CoverageStatus, string> = {
  covered: "Covered",
  failing: "Failing",
  uncovered: "Uncovered",
};

const methodClass = (method: string) => `m-${method.toLowerCase()}`;

/**
 * Deep-link to a single story inside the Scenario Explorer, so "verified by X"
 * always takes you to X. Respects Astro's configured `base`.
 */
const explorerUrl = (storyId: string): string => {
  const base = import.meta.env.BASE_URL ?? "/";
  const prefix = base.endsWith("/") ? base : `${base}/`;
  return `${prefix}explorer/#${encodeURIComponent(storyId)}`;
};
---

<section class="api-ops">
  <header class="api-ops__bar">
    <p class="api-ops__lede">
      Generated from the OpenAPI spec.{" "}
      {hasRun
        ? "Coverage reflects the last test run."
        : "Re-run with --run <story-report.json> to show per-endpoint coverage."}
    </p>
    {
      hasRun && (
        <div class="api-ops__stats" role="group" aria-label="Coverage summary">
          <span class="stat stat--covered">
            <strong>{summary.covered}</strong> covered
          </span>
          {summary.failing > 0 && (
            <span class="stat stat--failing">
              <strong>{summary.failing}</strong> failing
            </span>
          )}
          <span class="stat stat--uncovered">
            <strong>{summary.uncovered}</strong> no test
          </span>
          <span class="stat stat--total">of {summary.total}</span>
        </div>
      )
    }
  </header>

  <div class="api-ops__rows" role="table" aria-label="API endpoints">
    <div class="api-ops__row api-ops__row--head" role="row">
      <span role="columnheader">Endpoint</span>
      <span role="columnheader">Summary</span>
      {hasRun && <span role="columnheader">Coverage</span>}
      {hasRun && <span role="columnheader">Verified by</span>}
    </div>
    {
      endpoints.map((ep) => (
        <div class="api-ops__row" role="row">
          <span class="cell-endpoint" role="cell">
            <span class:list={["method", methodClass(ep.method)]}>{ep.method}</span>
            <code class="path">{ep.path}</code>
          </span>
          <span class="cell-summary" role="cell">{ep.summary || "—"}</span>
          {hasRun && (
            <span role="cell">
              <span class:list={["coverage", `coverage--${ep.status}`]}>
                <span class="coverage__dot" aria-hidden="true" />
                {coverageLabel[ep.status]}
              </span>
            </span>
          )}
          {hasRun && (
            <span class="cell-stories" role="cell">
              {ep.stories.length === 0 ? (
                <span class="no-stories">—</span>
              ) : (
                ep.stories.map((s) => (
                  <a class:list={["story-chip", `story-chip--${s.status}`]} href={explorerUrl(s.id)}>
                    <span class="story-chip__dot" aria-hidden="true" />
                    {s.title}
                  </a>
                ))
              )}
            </span>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Local token fallbacks so the table renders standalone (matches es.css). */
  .api-ops {
    --es-line: var(--sl-color-gray-5, #d9dbe0);
    --es-bg: var(--sl-color-bg, #fff);
    --es-surface: var(--sl-color-gray-7, #f6f7f9);
    --es-surface-2: var(--sl-color-gray-6, #eceef2);
    --es-text: var(--sl-color-text, #1c1e21);
    --es-text-soft: var(--sl-color-gray-2, #3c4149);
    --es-text-muted: var(--sl-color-gray-3, #6b7280);
    --es-passed: #1a7f37;
    --es-failed: #cf222e;
    --es-skipped: #9a6700;
    --es-pending: #6b7280;
    --es-passed-soft: color-mix(in oklab, var(--es-passed) 12%, transparent);
    --es-failed-soft: color-mix(in oklab, var(--es-failed) 12%, transparent);
    --es-skipped-soft: color-mix(in oklab, var(--es-skipped) 12%, transparent);
    --es-radius: 8px;
    --es-radius-sm: 4px;
    --es-radius-pill: 999px;
    --es-mono: var(--sl-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    --es-method-default: #6b7280;
    --es-method-get: #1f6feb;
    --es-method-post: #1a7f37;
    --es-method-put: #9a6700;
    --es-method-patch: #8250df;
    --es-method-delete: #cf222e;
    margin: 1.25rem 0 2rem;
  }

  .api-ops__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1rem;
  }

  .api-ops__lede {
    margin: 0;
    color: var(--es-text-muted);
    font-size: 0.85rem;
    max-width: 52ch;
  }

  .api-ops__stats {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .stat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-size: 0.72rem;
    color: var(--es-text-muted);
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--es-line);
    border-radius: var(--es-radius-pill);
    background: var(--es-surface);
  }
  .stat strong {
    font-size: 0.85rem;
    color: var(--es-text);
  }
  .stat--covered {
    color: var(--es-passed);
    border-color: color-mix(in oklab, var(--es-passed) 40%, var(--es-line));
    background: var(--es-passed-soft);
  }
  .stat--covered strong {
    color: var(--es-passed);
  }
  .stat--failing {
    color: var(--es-failed);
    border-color: color-mix(in oklab, var(--es-failed) 40%, var(--es-line));
    background: var(--es-failed-soft);
  }
  .stat--failing strong {
    color: var(--es-failed);
  }
  .stat--uncovered {
    color: var(--es-skipped);
    border-color: color-mix(in oklab, var(--es-skipped) 40%, var(--es-line));
    background: var(--es-skipped-soft);
  }
  .stat--uncovered strong {
    color: var(--es-skipped);
  }
  .stat--total {
    border: none;
    background: none;
  }

  .api-ops__rows {
    border: 1px solid var(--es-line);
    border-radius: var(--es-radius);
    overflow: hidden;
    background: var(--es-bg);
  }

  .api-ops__row {
    display: grid;
    grid-template-columns: minmax(220px, 1.2fr) minmax(140px, 1.4fr) auto minmax(160px, 1.3fr);
    gap: 1rem;
    align-items: center;
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--es-line);
  }
  .api-ops__row:first-child {
    border-top: none;
  }
  .api-ops__row:not(.api-ops__row--head):hover {
    background: var(--es-surface);
  }

  .api-ops__row--head {
    background: var(--es-surface-2);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--es-text-muted);
  }

  .cell-endpoint {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .method {
    flex: none;
    font-family: var(--es-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.45rem;
    border-radius: var(--es-radius-sm);
    color: #fff;
    background: var(--es-method-default);
  }
  .m-get {
    background: var(--es-method-get);
  }
  .m-post {
    background: var(--es-method-post);
  }
  .m-put {
    background: var(--es-method-put);
  }
  .m-patch {
    background: var(--es-method-patch);
  }
  .m-delete {
    background: var(--es-method-delete);
  }

  .path {
    font-family: var(--es-mono);
    font-size: 0.85rem;
    color: var(--es-text);
    background: none;
    border: none;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cell-summary {
    color: var(--es-text-soft);
    font-size: 0.85rem;
  }

  .coverage {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--es-radius-pill);
    border: 1px solid currentcolor;
    white-space: nowrap;
  }
  .coverage__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentcolor;
  }
  .coverage--covered {
    color: var(--es-passed);
    background: var(--es-passed-soft);
  }
  .coverage--failing {
    color: var(--es-failed);
    background: var(--es-failed-soft);
  }
  .coverage--uncovered {
    color: var(--es-skipped);
    background: var(--es-skipped-soft);
  }

  .cell-stories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .story-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    text-decoration: none;
    color: var(--es-text-soft);
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--es-line);
    border-radius: var(--es-radius-pill);
    background: var(--es-surface);
    transition:
      border-color 120ms ease,
      color 120ms ease;
  }
  .story-chip:hover {
    border-color: var(--es-accent, var(--sl-color-accent, #3245ff));
    color: var(--es-text);
  }
  .story-chip:focus-visible {
    outline: 2px solid var(--es-accent, var(--sl-color-accent, #3245ff));
    outline-offset: 2px;
  }
  .story-chip__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--chip-dot, var(--es-text-muted));
  }
  .story-chip--passed {
    --chip-dot: var(--es-passed);
  }
  .story-chip--failed {
    --chip-dot: var(--es-failed);
  }
  .story-chip--skipped {
    --chip-dot: var(--es-skipped);
  }
  .story-chip--pending {
    --chip-dot: var(--es-pending);
  }

  .no-stories {
    color: var(--es-text-muted);
  }

  @media (max-width: 720px) {
    .api-ops__row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .api-ops__row--head {
      display: none;
    }
    .cell-summary {
      color: var(--es-text-muted);
    }
  }
</style>
