{
  "name": "executable-stories-astro",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/executable-stories.git",
    "directory": "packages/executable-stories-astro"
  },
  "description": "Astro integration for executable-stories: a content loader that turns the test run JSON into a live, hot-reloading docs collection.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./routes/stories.astro": "./routes/stories.astro",
    "./routes/story.astro": "./routes/story.astro",
    "./components/Trajectory.astro": "./components/Trajectory.astro",
    "./components/VerifiedBy.astro": "./components/VerifiedBy.astro",
    "./components/HealthDashboard.astro": "./components/HealthDashboard.astro",
    "./components/ApiOperations.astro": "./components/ApiOperations.astro",
    "./routes/explorer.astro": "./routes/explorer.astro",
    "./routes/starlight/stories.astro": "./routes/starlight/stories.astro",
    "./routes/starlight/story.astro": "./routes/starlight/story.astro",
    "./routes/starlight/explorer.astro": "./routes/starlight/explorer.astro"
  },
  "files": [
    "dist",
    "routes",
    "components",
    "styles"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "astro": ">=7",
    "@astrojs/react": ">=4",
    "@astrojs/starlight": ">=0.41.0",
    "executable-stories-react": "workspace:*",
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7"
  },
  "peerDependenciesMeta": {
    "@astrojs/react": {
      "optional": true
    },
    "@astrojs/starlight": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/react": "^4.4.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.0",
    "executable-stories-core": "workspace:*",
    "executable-stories-react": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  }
}
