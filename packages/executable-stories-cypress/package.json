{
  "name": "executable-stories-cypress",
  "version": "8.3.3",
  "description": "BDD-style executable stories for Cypress with documentation generation",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "import": "./dist/support.js",
      "require": "./dist/support.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "require": "./dist/reporter.cjs"
    }
  },
  "files": [
    "dist",
    "skills",
    "reporter.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "cypress run"
  },
  "peerDependencies": {
    "cypress": ">=15.16.0"
  },
  "dependencies": {
    "executable-stories-formatters": "workspace:*"
  },
  "devDependencies": {
    "cypress": "^15.14.2",
    "@types/node": "^25.9.2",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/executable-stories.git",
    "directory": "packages/executable-stories-cypress"
  },
  "keywords": [
    "cypress",
    "bdd",
    "testing",
    "documentation",
    "executable-stories"
  ]
}
