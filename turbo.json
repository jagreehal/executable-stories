{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Turbo's strict env mode drops TMPDIR, so child processes fall back to /tmp.
  // That breaks any sandbox that only grants the session temp dir.
  "globalPassThroughEnv": ["TMPDIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!coverage/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!coverage/**"
      ],
      "outputs": [],
      "passThroughEnv": ["CI"]
    },
    "clean": {
      "cache": false
    }
  }
}
