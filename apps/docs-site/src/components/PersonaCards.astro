---
const cards = [
  {
    label: 'Product Owner',
    modifier: 'po',
    content: `Feature: User Authentication

Scenario: User logs in successfully
  A registered user can access their
  dashboard by entering valid credentials.

  Outcome: User sees personalised dashboard
  Business rule: Session expires after 30 min`,
  },
  {
    label: 'Developer',
    modifier: 'dev',
    content: `## User logs in successfully

Given a registered user exists in the database
When POST /api/auth/login { email, password }
Then response status is 200
And body contains { token, expiresIn: 1800 }
And session is stored in Redis with TTL 1800s`,
  },
  {
    label: 'QA / Compliance',
    modifier: 'qa',
    content: `TC-AUTH-001: User logs in successfully

Preconditions:
  - User account exists and is active
  - Account is not locked (< 5 failed attempts)

Steps:
  1. Submit valid credentials
  2. Verify 200 response with JWT token
  3. Verify session created with correct TTL
  4. Verify audit log entry created

Traceability: REQ-AUTH-001, SOC2-CC6.1`,
  },
];
---

<div class="persona-grid not-content">
  {cards.map((card) => (
    <div class="persona-card">
      <span class={`persona-tag persona-tag--${card.modifier}`}>{card.label}</span>
      <pre class="persona-code"><code>{card.content}</code></pre>
    </div>
  ))}
</div>

<p class="persona-cta not-content">
  Built with <a href="ai-skills/">AI agent skills</a> — markdown files you drop into your project. Use ours or write your own.
</p>

<style>
  .persona-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .persona-card {
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.75rem;
    overflow: hidden;
    transition: border-color 200ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 200ms cubic-bezier(0.16, 1, 0.3, 1), transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .persona-card:hover {
    border-color: var(--sl-color-accent);
    box-shadow: 0 8px 32px rgba(45, 106, 79, 0.08);
    transform: translateY(-2px);
  }

  .persona-card:active {
    transform: translateY(0);
    transition-duration: 80ms;
  }

  .persona-tag {
    display: block;
    padding: 0.625rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--sl-color-gray-4);
  }

  .persona-tag--po {
    background: rgba(45, 106, 79, 0.08);
    color: var(--sl-color-accent);
  }

  .persona-tag--dev {
    background: rgba(59, 130, 246, 0.08);
    color: #3b82f6;
  }

  .persona-tag--qa {
    background: rgba(168, 85, 247, 0.08);
    color: #a855f7;
  }

  .persona-code {
    margin: 0;
    padding: 1rem 1.25rem;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
    background: transparent;
    border: none;
    overflow-x: auto;
    white-space: pre;
  }

  .persona-code code {
    font-family: inherit;
    font-size: inherit;
    background: transparent;
    padding: 0;
  }

  .persona-cta {
    max-width: 1200px;
    margin: 1rem auto 0;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  .persona-cta a {
    color: var(--sl-color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .persona-cta a:hover {
    color: var(--sl-color-accent-high);
  }

  @media (max-width: 768px) {
    .persona-grid { grid-template-columns: 1fr; }
  }
</style>
