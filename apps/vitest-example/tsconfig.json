{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "executable-stories-vitest": [
        "../../packages/executable-stories-vitest/dist/index.d.ts",
        "../../packages/executable-stories-vitest/src/index.ts"
      ],
      "executable-stories-vitest/*": [
        "../../packages/executable-stories-vitest/dist/*",
        "../../packages/executable-stories-vitest/src/*"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest"]
  },
  "include": ["src/**/*", "vitest.config.ts"]
}

